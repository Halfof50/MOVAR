SUPABASE_URL=
# Backend-only key; never commit real keys or copy them into frontend code.
SUPABASE_KEY=
# Backend-only Gemini key for LLM reports.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash.
# GEMINI_MODEL=
