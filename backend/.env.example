# Vision model server (ai/inference), e.g. http://127.0.0.1:8001 when run locally. Must not share backend's port 8000.
MOVAR_VISION_API_BASE_URL=
# Backend-only Kakao REST API key for nearby hospital search.
KAKAO_REST_API_KEY=